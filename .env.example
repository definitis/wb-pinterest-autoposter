# Основной сценарий: сбор новинок WB -> публикация в соцсети.
#
# Перед реальной публикацией скопируйте этот файл в .env:
#   copy .env.example .env
#
# Заполняйте только нужные блоки. Для текущего Pinterest-пилота через Zernio
# достаточно локального хранения, Zernio-блока и baseline WB.

# Локальное хранение проекта. Обычно можно оставить как есть.
WB_AUTOPOSTER_DB_PATH=out/app.sqlite3
WB_AUTOPOSTER_OUT_DIR=out

# Генерация коротких текстов через Gemini.
# Если GEMINI_API_KEY пустой, пайплайн не падает и использует локальные fallback-шаблоны.
# Один запрос к Gemini возвращает сразу vk/instagram/pinterest тексты для одного товара.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CONTENT_RULES_PATH=config/content_rules.example.json

# Pinterest/Zernio.
# Реальная публикация через Zernio включается только после проверки:
#   python -m wb_autoposter.cli zernio-check --platform pinterest
#
# Безопасная проверка без публикации:
#   python -m wb_autoposter.cli wb-pinterest-cycle --seller-url "https://www.wildberries.ru/seller/..." --dry-run
#
# Реальная публикация одной карточки:
#   python -m wb_autoposter.cli wb-pinterest-cycle --seller-url "https://www.wildberries.ru/seller/..." --no-dry-run --limit 1
ZERNIO_API_KEY=
ZERNIO_ENABLE_REAL_PUBLISH=0
ZERNIO_PINTEREST_ACCOUNT_ID=
ZERNIO_PINTEREST_BOARD_ID=

# Лимит Pinterest-постов за один запуск. Полезно для тестов и защиты от лишних публикаций.
PINTEREST_POST_LIMIT_PER_RUN=3

# Прямой Pinterest API оставлен как альтернативный путь.
# Для Zernio этот токен не нужен.
PINTEREST_BOARD_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_ENABLE_REAL_PUBLISH=0

# Целевая VK-группа. Нужна только если используется VK-сценарий.
# Пример для https://vk.com/club239286699:
#   VK_OWNER_ID=-239286699
#   VK_GROUP_ID=239286699
#   VK_BROWSER_GROUP_URL=https://vk.com/club239286699
VK_OWNER_ID=
VK_GROUP_ID=
VK_BROWSER_GROUP_URL=

# Защитный переключатель браузерной публикации VK.
# Оставьте 0, пока VK-сессия не сохранена и группа не проверена.
# Поставьте 1 только когда готовы использовать:
#   python -m wb_autoposter.cli publish --platform vk --browser --no-dry-run
#   python -m wb_autoposter.cli wb-vk-cycle ... --browser --no-dry-run
VK_BROWSER_ENABLE=0

# Сохраненная VK-сессия, создается командой:
#   python -m wb_autoposter.cli vk-browser-login
VK_BROWSER_STATE_PATH=out/vk_browser_state.json

# Поведение браузера.
# 0 = видимый браузер, рекомендуется для MVP/пилота.
VK_BROWSER_HEADLESS=0

# 0 = публиковать автоматически после подготовки поста.
# 1 = остановиться перед финальной публикацией для ручной проверки.
VK_BROWSER_CONFIRM_BEFORE_POST=0

# Максимум VK-постов за один реальный запуск.
VK_POST_LIMIT_PER_RUN=3

# Instagram через Zernio. Реальная публикация включается после подключения аккаунта в Zernio.
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_INSTAGRAM_CONTENT_TYPE=feed
INSTAGRAM_POST_LIMIT_PER_RUN=3

# Прямой Instagram Graph API оставлен как альтернативный путь.
# Для Zernio эти поля не нужны.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ENABLE_REAL_PUBLISH=0
