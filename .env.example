# Основной MVP: браузерный сбор WB -> браузерная публикация во VK
#
# Перед реальной VK-публикацией скопируйте этот файл в .env:
#   copy .env.example .env
#
# Заполните только пустые значения в VK-блоке.

# Локальное хранение проекта. Обычно можно оставить как есть.
WB_AUTOPOSTER_DB_PATH=out/app.sqlite3
WB_AUTOPOSTER_OUT_DIR=out

# Целевая VK-группа.
# Пример для https://vk.com/club239286699:
#   VK_OWNER_ID=-239286699
#   VK_GROUP_ID=239286699
#   VK_BROWSER_GROUP_URL=https://vk.com/club239286699
VK_OWNER_ID=
VK_GROUP_ID=
VK_BROWSER_GROUP_URL=

# Защитный переключатель браузерной публикации.
# Оставьте 0, пока VK-сессия не сохранена и группа не проверена.
# Поставьте 1 только когда готовы использовать:
#   python -m wb_autoposter.cli publish --platform vk --browser --no-dry-run
#   python -m wb_autoposter.cli wb-vk-cycle ... --browser --no-dry-run
VK_BROWSER_ENABLE=0

# Сохраненная VK-сессия, создается командой:
#   python -m wb_autoposter.cli vk-browser-login
VK_BROWSER_STATE_PATH=out/vk_browser_state.json

# Поведение браузера.
# 0 = видимый браузер, рекомендуется для MVP/пилота.
VK_BROWSER_HEADLESS=0

# 0 = публиковать автоматически после подготовки поста.
# 1 = остановиться перед финальной публикацией для ручной проверки.
VK_BROWSER_CONFIRM_BEFORE_POST=0

# Максимум VK-постов за один реальный запуск. Полезно для тестов и защиты от лишних публикаций.
VK_POST_LIMIT_PER_RUN=3

# Zernio optional pilot for Pinterest/Instagram.
# Keep real publish disabled until zernio-check shows the connected account IDs.
ZERNIO_API_KEY=
ZERNIO_ENABLE_REAL_PUBLISH=0
ZERNIO_PROFILE_ID=
ZERNIO_PINTEREST_ACCOUNT_ID=
ZERNIO_PINTEREST_BOARD_ID=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_INSTAGRAM_CONTENT_TYPE=feed
